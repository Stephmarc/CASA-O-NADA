{"uid": "casa", "title": "CASA O NADA \u00b7 Diagn\u00f3stico", "schemaVersion": 39, "version": 1, "refresh": "10s", "panels": [{"id": 1, "title": "Servicios disponibles", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "up", "refId": "A"}]}, {"id": 2, "title": "Solicitudes por segundo", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by(job)(rate(http_server_requests_seconds_count[1m]))", "refId": "A"}]}, {"id": 3, "title": "Errores HTTP", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by(job)(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "refId": "A"}]}, {"id": 4, "title": "Tiempo medio de respuesta", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by(job)(rate(http_server_requests_seconds_sum[1m])) / sum by(job)(rate(http_server_requests_seconds_count[1m]))", "refId": "A"}]}, {"id": 5, "title": "Memoria JVM", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "sum by(job)(jvm_memory_used_bytes)", "refId": "A"}]}, {"id": 6, "title": "Logs correlacionados: filtra por X-Trace-ID", "type": "logs", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "{job=~\"casa.*\"}", "refId": "A"}]}]}