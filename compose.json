        "interval": "10s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "30s"
      },
      "depends_on": {
        "config": {
          "condition": "service_healthy"
        },
        "eureka": {
          "condition": "service_healthy"
        },
        "postgres": {
          "condition": "service_healthy"
        }
      }
    },
