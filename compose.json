    "frontend": {
      "build": {
        "context": "clients/casa-frontend"
      },
      "ports": [
        "127.0.0.1:4200:80"
      ],
      "depends_on": [
        "gateway"
      ]
    },
    "prometheus": {
      "image": "prom/prometheus:v3.5.0",
      "ports": [
        "127.0.0.1:19090:9090"
      ],
      "volumes": [
        "./obs/prometheus/casa.yml:/etc/prometheus/prometheus.yml:ro",
        "./obs/prometheus/alerts.yml:/etc/prometheus/alerts.yml:ro"
      ]
    },
    "loki": {
      "image": "grafana/loki:3.5.0",
      "command": [
        "-config.file=/etc/loki/local-config.yaml"
      ],
      "ports": [
        "127.0.0.1:13100:3100"
      ]
    },
    "promtail": {
      "image": "grafana/promtail:3.5.0",
      "command": [
        "-config.file=/etc/promtail/config.yml"
      ],
      "volumes": [
        "./obs/promtail/casa.yml:/etc/promtail/config.yml:ro",
        "./services:/logs/services:ro",
        "./infra:/logs/infra:ro"
      ],
      "depends_on": [
        "loki"
      ]
    },
    "grafana": {
      "image": "grafana/grafana:12.1.0",
      "ports": [
        "127.0.0.1:13000:3000"
      ],
      "environment": {
        "GF_SECURITY_ADMIN_PASSWORD": "Casa2026!"
      },
      "volumes": [
        "./obs/grafana/casa:/etc/grafana/provisioning:ro",
        "./obs/grafana/dashboards:/var/lib/grafana/dashboards:ro"
      ],
      "depends_on": [
        "prometheus",
        "loki"
      ]
    },
    "auth": {
