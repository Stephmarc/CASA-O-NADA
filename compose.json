        "CONFIG_SERVER_URL": "http://config:8080",
        "EUREKA_CLIENT_SERVICEURL_DEFAULTZONE": "http://eureka:8080/eureka/",
        "EUREKA_INSTANCE_HOSTNAME": "propiedad",
        "EUREKA_INSTANCE_PREFER_IP_ADDRESS": "false",
        "EUREKA_INSTANCE_INSTANCE_ID": "propiedad:8080",
        "SPRING_DEVTOOLS_RESTART_ENABLED": "false",
        "SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI": "http://localhost:18180/realms/casa",
        "SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI": "http://keycloak:8080/realms/casa/protocol/openid-connect/certs",
        "CASA_INTERNAL_SECRET": "${CASA_INTERNAL_SECRET:-casa-local-internal-change-me}",
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://postgres:5432/casa_propiedad_db",
        "SPRING_DATASOURCE_USERNAME": "casa",
        "SPRING_DATASOURCE_PASSWORD": "casa-local",
        "SPRING_KAFKA_BOOTSTRAP_SERVERS": "kafka:9092",
        "DOCUMENTOS_TOKEN": "${DOCUMENTOS_TOKEN:-}",
        "JAVA_TOOL_OPTIONS": "-Xms64m -Xmx384m -XX:+UseSerialGC"
      },
      "ports": [
        "127.0.0.1:18102:8080"
      ],
      "volumes": [
        "./services/casa-propiedad-ms/logs:/app/logs"
      ],
      "healthcheck": {
