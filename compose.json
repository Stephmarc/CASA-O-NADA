        "SPRING_KAFKA_BOOTSTRAP_SERVERS": "kafka:9092",
        "DOCUMENTOS_TOKEN": "${DOCUMENTOS_TOKEN:-}",
        "JAVA_TOOL_OPTIONS": "-Xms64m -Xmx384m -XX:+UseSerialGC"
      },
      "ports": [
        "127.0.0.1:18103:8080"
      ],
      "volumes": [
        "./services/casa-propiedad-ms/logs:/app/logs"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "bash -c \"echo > /dev/tcp/localhost/8080\""
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "30s"
      },
      "depends_on": {
        "config": {
          "condition": "service_healthy"
        },
        "eureka": {
          "condition": "service_healthy"
        },
        "postgres": {
          "condition": "service_healthy"
        }
      }
    },
